local GENERATOR_DONE_COLOR = Color3.fromRGB(0, 0, 139)

-- Функция для определения убийцы
local function isKiller(player)
    if player.Team then
        local teamName = player.Team.Name:lower()
        if teamName:find("killer") or teamName:find("murder") or teamName:find("hunter") then
            return true
        end
    end
    if player.TeamColor and player.TeamColor.Color then
        local r, g, b = player.TeamColor.Color.r, player.TeamColor.Color.g, player.TeamColor.Color.b
        if r > 0.6 and g < 0.4 and b < 0.4 then
            return true
        end
    end
    local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
    if humanoid and humanoid.WalkSpeed > 20 then
        return true
    end
    return false
end

-- Подсветка игрока
local function highlightPlayer(player)
    if player == LocalPlayer then return end
    local character = player.Character
    if not character then return end
    if playerHighlights[player] then
        playerHighlights[player]:Destroy()
        playerHighlights[player] = nil
    end
    local color = isKiller(player) and KILLER_COLOR or SURVIVOR_COLOR
    local highlight = Instance.new("Highlight")
    highlight.FillColor = color
    highlight.OutlineColor = color
    highlight.Parent = character
    playerHighlights[player] = highlight
end

local function unhighlightPlayer(player)
    if playerHighlights[player] then
        playerHighlights[player]:Destroy()
        playerHighlights[player] = nil
    end
end

local function refreshPlayerHighlight(player)
    if ESPPlayersEnabled and player.Character then
        highlightPlayer(player)
    end
end

local function setupPlayerESP()
    if ESPPlayersEnabled then return end
    ESPPlayersEnabled = true

    for _, player in pairs(Players:GetPlayers()) do
        if player.Character then highlightPlayer(player) end
        player:GetPropertyChangedSignal("Team"):Connect(function()
            refreshPlayerHighlight(player)
        end)
        player:GetPropertyChangedSignal("TeamColor"):Connect(function()
            refreshPlayerHighlight(player)
        end)
        player.CharacterAdded:Connect(function(character)
            if ESPPlayersEnabled then
                highlightPlayer(player)
                local humanoid = character:WaitForChild("Humanoid", 3)
                if humanoid then
                    humanoid:GetPropertyChangedSignal("WalkSpeed"):Connect(function()
                        refreshPlayerHighlight(player)
                    end)
                end
            end
        end)
    end

    Players.PlayerAdded:Connect(function(player)
        player:GetPropertyChangedSignal("Team"):Connect(function()
            refreshPlayerHighlight(player)
        end)
        player:GetPropertyChangedSignal("TeamColor"):Connect(function()
            refreshPlayerHighlight(player)
        end)
        player.CharacterAdded:Connect(function(character)
            if ESPPlayersEnabled then
                highlightPlayer(player)
                local humanoid = character:WaitForChild("Humanoid", 3)
                if humanoid then
                    humanoid:GetPropertyChangedSignal("WalkSpeed"):Connect(function()
                        refreshPlayerHighlight(player)
                    end)
                end
            end
        end)
        if player.Character then highlightPlayer(player) end
    end)

    Players.PlayerRemoving:Connect(function(player)
        unhighlightPlayer(player)
    end)
end

local function disablePlayerESP()
    ESPPlayersEnabled = false
    for _, player in pairs(Players:GetPlayers()) do
        unhighlightPlayer(player)
    end
