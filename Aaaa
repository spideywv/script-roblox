--[[ DBD Script - Ультра-лёгкая версия для ПК (без Rayfield)
     Функции: ESP игроков, ESP генераторов, WalkSpeed, Fast Repair,
     No Skillcheck Fail, Immunity ]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local LocalPlayer = Players.LocalPlayer

-- Переменные
local ESPPlayers = false
local ESPGenerators = false
local SpeedEnabled = true
local desiredSpeed = 21
local FastRepair = false
local NoSkillcheckFail = true
local Immunity = true
local highlights = {}
local genHighlights = {}
local maxProgress = {}

-- Цвета
local SURVIVOR_COLOR = Color3.fromRGB(0, 255, 0)
local KILLER_COLOR = Color3.fromRGB(255, 0, 0)
local GENERATOR_COLOR = Color3.fromRGB(255, 255, 0)
local GENERATOR_DONE_COLOR = Color3.fromRGB(0, 0, 139)

