        highlightCharacter(character) 
    end
    
    local player = Players:GetPlayerFromCharacter(character)
    if player and NameESPEnabled then
        task.spawn(function()
            addNameTag(player)
        end)
    end
end

local function onPlayerAdded(newPlayer)
    if newPlayer ~= LocalPlayer then
        local charAddedConn = newPlayer.CharacterAdded:Connect(function(character) 
            onCharacterAdded(character) 
        end)
        table.insert(ESPConnections, charAddedConn)
        
        if newPlayer.Character then 
            onCharacterAdded(newPlayer.Character) 
        end
    end
end

local function clearESP()
    ESPEnabled = false
    for _, conn in pairs(ESPConnections) do 
        if conn and conn.Disconnect then 
            conn:Disconnect() 
        end 
    end
    ESPConnections = {}
    
    for _, player in pairs(Players:GetPlayers()) do
        if player.Character then
            for _, child in pairs(player.Character:GetChildren()) do 
                if child:IsA("Highlight") then 
                    child:Destroy() 
                end 
            end
        end
    end
    ESPHighlights = {}
end

local function toggleESP(enabled)
    if enabled then
        clearESP()
        ESPEnabled = true
        for _, player in pairs(Players:GetPlayers()) do 
            onPlayerAdded(player) 
        end
        local playerAddedConn = Players.PlayerAdded:Connect(onPlayerAdded)
        table.insert(ESPConnections, playerAddedConn)
    else
        clearESP()
    end
end

-- Hidden DN ESP
local HiddenDnEspActive = false
local hiddenDnHighlights = {}
local NOTE_KEYWORDS = { "death note", "deathnote", "note", "notebook", "тетрадь", "блокнот", "book", "diary", "journal", "письмо", "записка" }

local function containsNoteKeyword(s)
    s = string.lower(tostring(s))
    for _, kw in ipairs(NOTE_KEYWORDS) do
        if string.find(s, kw, 1, true) then 
            return true 
        end
    end
    return false
end

local function ClearHiddenDnEsp()
    for _, hl in pairs(hiddenDnHighlights) do 
        if hl and hl.Destroy then 
            hl:Destroy() 
        end 
    end
    hiddenDnHighlights = {}
end

local function UpdateHiddenDnEsp()
    ClearHiddenDnEsp()
    local success, err = pcall(function()
        for _, obj in pairs(workspace:GetDescendants()) do
            if containsNoteKeyword(obj.Name) then
                local hl1 = Instance.new("Highlight")
                hl1.FillColor = Color3.fromRGB(255, 0, 255)
                hl1.OutlineColor = Color3.fromRGB(100, 0, 100)
                hl1.FillTransparency = 0.5
                hl1.OutlineTransparency = 0.3
                hl1.Parent = obj
                table.insert(hiddenDnHighlights, hl1)

                local parent = obj.Parent
                while parent and parent ~= workspace and parent ~= workspace.Map do
                    if parent:IsA("Model") or parent:IsA("BasePart") then
                        if not parent:FindFirstChildOfClass("Humanoid") then
                            local hl2 = Instance.new("Highlight")
                            hl2.FillColor = Color3.fromRGB(0, 255, 255)
                            hl2.OutlineColor = Color3.fromRGB(0, 100, 100)
                            hl2.FillTransparency = 0.6
                            hl2.OutlineTransparency = 0.4
                            hl2.Parent = parent
                            table.insert(hiddenDnHighlights, hl2)
                        end
                        break
                    end
                    parent = parent.Parent
                end
            end
        end
    end)
end

local function StartHiddenDnEsp()
    if HiddenDnEspActive then return end
    HiddenDnEspActive = true
    task.spawn(function() 
        while HiddenDnEspActive do 
            task.wait(0.5)
            UpdateHiddenDnEsp() 
        end 
    end)
end

local function StopHiddenDnEsp()
    HiddenDnEspActive = false
    ClearHiddenDnEsp()
end

-- ID ESP (mini)
local IdEspActive = false
local IdEspConnection = nil
local IdEspMapConnections = {}

local function ClearAllIdEsp()
    local success, err = pcall(function()
        local Map = workspace:FindFirstChild("Map")
        if Map then
            for _, v in pairs(Map:GetChildren()) do
                if v.Name == "Id" then
                    local oldBox = v:FindFirstChild("IdEspBox")
                    local oldTag = v:FindFirstChild("IdEspTag")
                    if oldBox then oldBox:Destroy() end
                    if oldTag then oldTag:Destroy() end
                end
            end
        end
    end)
end

local function UpdateIdEsp()
    local success, err = pcall(function()
        local Map = workspace:FindFirstChild("Map")
        if not Map then return end

        for _, v in pairs(Map:GetChildren()) do
            if v.Name == "Id" and v:IsA("BasePart") then
                local ownerName = ""
                local isClaimed = false

                local surfaceGui = v:FindFirstChildOfClass("SurfaceGui")
                if surfaceGui and surfaceGui.Enabled then
                    local frame = surfaceGui:FindFirstChild("Frame")
                    local pNameLabel = frame and frame:FindFirstChild("PlayerName")
                    if pNameLabel then
                        ownerName = pNameLabel.Text
                        local cleanName = string.gsub(ownerName, "%s+", "")
                        if cleanName ~= "" and not string.find(string.lower(cleanName), "polo") then
                            isClaimed = true
                        end
                    end
                end

                if isClaimed then
                    local isMyId = (ownerName == LocalPlayer.Name or ownerName == LocalPlayer.DisplayName)

                    local box = v:FindFirstChild("IdEspBox")
                    if not box then
                        box = Instance.new("BoxHandleAdornment")
                        box.Name = "IdEspBox"
                        box.Size = v.Size + Vector3.new(0.05, 0.05, 0.05)
                        box.AlwaysOnTop = true
                        box.ZIndex = 5
                        box.Color3 = isMyId and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(120, 120, 120)
                        box.Transparency = 0.6
                        box.Adornee = v
                        box.Parent = v
                    else
                        box.Color3 = isMyId and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(120, 120, 120)
                    end

                    local tag = v:FindFirstChild("IdEspTag")
                    if not tag then
                        tag = Instance.new("BillboardGui")
                        tag.Name = "IdEspTag"
                        tag.Size = UDim2.new(0, 100, 0, 15)
                        tag.AlwaysOnTop = true
                        tag.ExtentsOffset = Vector3.new(0, 1.2, 0)

                        local label = Instance.new("TextLabel")
                        label.Size = UDim2.new(1, 0, 1, 0)
                        label.BackgroundTransparency = 1
                        label.TextColor3 = isMyId and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(185, 90, 255)
                        label.TextSize = 8
                        label.TextScaled = false
                        label.Font = Enum.Font.GothamBold
                        label.Text = ownerName
                        label.TextStrokeTransparency = 0.4
                        label.TextStrokeColor3 = Color3.new(0, 0, 0)
                        label.Parent = tag

                        tag.Parent = v
                    else
                        local label = tag:FindFirstChildOfClass("TextLabel")
                        if label then
                            label.Text = ownerName
                            label.TextColor3 = isMyId and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(185, 90, 255)
                        end
                    end
                else
                    local oldBox = v:FindFirstChild("IdEspBox")
                    if oldBox then oldBox:Destroy() end
                    local oldTag = v:FindFirstChild("IdEspTag")
                    if oldTag then oldTag:Destroy() end
                end
            end
        end
    end)
end

local function StartIdEsp()
    if IdEspActive then return end
    IdEspActive = true

    local Map = workspace:FindFirstChild("Map")
    if Map then
        local connAdded = Map.ChildAdded:Connect(function(child)
            if child.Name == "Id" then
                task.spawn(UpdateIdEsp)
            end
        end)
        table.insert(IdEspMapConnections, connAdded)

        local connRemoved = Map.ChildRemoved:Connect(function(child)
            if child.Name == "Id" then
                local oldBox = child:FindFirstChild("IdEspBox")
                if oldBox then oldBox:Destroy() end
                local oldTag = child:FindFirstChild("IdEspTag")
                if oldTag then oldTag:Destroy() end
            end
        end)
        table.insert(IdEspMapConnections, connRemoved)
    end

    IdEspConnection = RunService.Heartbeat:Connect(function()
        UpdateIdEsp()
    end)
end

local function StopIdEsp()
    IdEspActive = false
    if IdEspConnection then
        IdEspConnection:Disconnect()
        IdEspConnection = nil
    end
    for _, conn in pairs(IdEspMapConnections) do
        if conn then conn:Disconnect() end
    end
    IdEspMapConnections = {}
    ClearAllIdEsp()
end

