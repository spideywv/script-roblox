-- Защитная обертка для callback'ов
local function safeCallback(name, func)
    return function(...)
        local success, err = pcall(func, ...)
        if not success then
            warn("[ERROR]", name, ":", err)
            if Rayfield and Rayfield.Notify then
                Rayfield:Notify({ 
                    Title = "Error", 
                    Content = name .. " failed: " .. tostring(err), 
                    Duration = 5 
                })
            end
        end
    end
end

