                if child:IsA("ObjectValue") then 
                    pcall(function() child:Destroy() end) 
                end 
            end
            for _, player in pairs(Players:GetPlayers()) do
                if player ~= LocalPlayer then
                    local idValue = Instance.new("ObjectValue")
                    idValue.Name = player.Name
                    idValue.Value = player
                    idValue.Parent = folder
                end
            end
            Rayfield:Notify({ Title = "Fill DN Locally", Content = "Filled local Death Notes", Duration = 2 })
        else
            Rayfield:Notify({ Title = "Error", Content = "FolderForIds not found", Duration = 3 })
        end
    end)
})

