local function ApplyChanceBypass()
    local success, result = pcall(function()
        local lWeight = LocalPlayer:FindFirstChild("LChance_Weight") or LocalPlayer:FindFirstChild("LChance") or LocalPlayer:FindFirstChild("LWeight")
        local kiraWeight = LocalPlayer:FindFirstChild("KiraChance_Weight") or LocalPlayer:FindFirstChild("KiraChance") or LocalPlayer:FindFirstChild("KiraWeight")
        
        if lWeight then pcall(function() lWeight.Value = lChanceValue end) end
        if kiraWeight then pcall(function() kiraWeight.Value = kiraChanceValue end) end

        local hasNote = false
        if LocalPlayer.Character then
            for _, item in pairs(LocalPlayer.Character:GetDescendants()) do
                if item:IsA("Tool") and (string.find(string.lower(item.Name), "death") or string.find(string.lower(item.Name), "note")) then
                    hasNote = true
                    break
                end
            end
        end
        
        if not hasNote and LocalPlayer:FindFirstChild("Backpack") then
            for _, item in pairs(LocalPlayer.Backpack:GetChildren()) do
                if item:IsA("Tool") and (string.find(string.lower(item.Name), "death") or string.find(string.lower(item.Name), "note")) then
                    hasNote = true
                    break
                end
            end
        end

        local kiraDisp, lDisp, role
        if hasNote or table.find(KiraList, LocalPlayer) or table.find(XKiraList, LocalPlayer) then
            kiraDisp = 100
            lDisp = 0
            role = "Кира (100%)"
        elseif table.find(TakaList, LocalPlayer) then
            kiraDisp = 0
            lDisp = 0
            role = "Такада (100%)"
        elseif table.find(MisaList, LocalPlayer) then
            kiraDisp = 0
            lDisp = 0
            role = "Миса (100%)"
        else
            kiraDisp = kiraChanceValue
            lDisp = lChanceValue
            role = "Kira " .. kiraChanceValue .. "% / L " .. lChanceValue .. "%"
        end

        return role, kiraDisp, lDisp
    end)
    
    if not success then
        warn("ApplyChanceBypass error:", result)
        return "Unknown", kiraChanceValue, lChanceValue
    end
    
    return result
end

